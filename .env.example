# Server Port (optional, defaults to 3000 locally)
PORT=3000

# Secret key for signing and verifying JWT tokens (required)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# MongoDB Connection String (required)
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# For MongoDB Atlas (required for cloud deployment on Vercel):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
